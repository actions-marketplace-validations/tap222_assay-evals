# Assay's own results database. SQLite is fine locally; use Postgres in production.
ASSAY_STORE_URL=sqlite:///./assay.db

# DocAI Core database, read-only credentials. Enables the "docai_core" source.
# ASSAY_DOCAI_URL=postgresql+psycopg://assay_ro:***@docai-db:5432/docai

# Optional: override column guesses in assay/sources/docai_core.py (see mapping.example.json).
# ASSAY_DOCAI_MAPPING=./mapping.json

# Optional: downstream record system, for the handoff-loss measure (joins on file_hash).
# ASSAY_DOWNSTREAM_URL=postgresql+psycopg://assay_ro:***@records-db:5432/records
# ASSAY_DOWNSTREAM_HASH_SQL=SELECT file_hash FROM records.documents

# Optional: require X-API-Key on /v1 endpoints (needed once external tenants push events).
# The dashboard asks for the key once and remembers it in the browser.
# ASSAY_API_KEY=

# --- Alerting ---
# Slack incoming-webhook URL (or any URL; use ASSAY_WEBHOOK_FORMAT=json for a structured body).
# ASSAY_WEBHOOK_URL=https://hooks.slack.com/services/...
# ASSAY_WEBHOOK_FORMAT=slack
# Where the dashboard lives, so alert messages link straight to the measure.
# ASSAY_PUBLIC_URL=https://assay.internal
# Slices smaller than this are never alerted on.
# ASSAY_ALERT_MIN_N=30
# A condition must hold on this many consecutive runs before it notifies.
# ASSAY_ALERT_AFTER_RUNS=2

# --- Built-in scheduler (or use cron / Celery Beat with `assay run`) ---
# ASSAY_SCHEDULE_MINUTES=60
# ASSAY_SCHEDULE_SOURCES=docai_core
# ASSAY_SCHEDULE_WINDOW_DAYS=1
