# Assay's own results database. SQLite is fine locally; use Postgres in production.
ASSAY_STORE_URL=sqlite:///./assay.db

# Your pipeline's database, read-only credentials. Enables the "sql" source.
# ASSAY_SOURCE_URL=postgresql+psycopg://assay_ro:***@pipeline-db:5432/pipeline

# Where your documents, stage runs, model calls and extractions live (see mappings/example.json).
# Without it, the reference schema in assay/sources/sql.py is assumed.
# ASSAY_SOURCE_MAPPING=./mappings/mine.json

# Optional: downstream record system, for the handoff-loss measure (joins on file_hash).
# ASSAY_DOWNSTREAM_URL=postgresql+psycopg://assay_ro:***@records-db:5432/records
# ASSAY_DOWNSTREAM_HASH_SQL=SELECT file_hash FROM records.documents

# --- Authentication ---
# Create keys with `python -m assay keys create --tenant acme --scopes ingest --name pipeline`;
# the first key switches authentication on. A break-glass platform key from the environment:
# ASSAY_ADMIN_KEY=
# auto (on once any key exists) | required (never run open) | off
# ASSAY_AUTH=auto
# Requests per minute per key, per instance (0 = no limit).
# ASSAY_RATE_LIMIT_PER_MIN=1200
# Browser origins allowed to call the API directly (comma-separated).
# ASSAY_CORS_ORIGINS=https://app.example.com

# --- Alerting ---
# Slack incoming-webhook URL (or any URL; use ASSAY_WEBHOOK_FORMAT=json for a structured body).
# ASSAY_WEBHOOK_URL=https://hooks.slack.com/services/...
# ASSAY_WEBHOOK_FORMAT=slack
# Signs every webhook (X-Assay-Signature: sha256=HMAC(secret, "<timestamp>.<body>")).
# ASSAY_WEBHOOK_SECRET=
# Where the dashboard lives, so alert messages link straight to the measure.
# ASSAY_PUBLIC_URL=https://assay.internal
# Slices smaller than this are never alerted on.
# ASSAY_ALERT_MIN_N=30
# A condition must hold on this many consecutive runs before it notifies.
# ASSAY_ALERT_AFTER_RUNS=2

# --- Built-in scheduler (or use cron / Celery Beat with `assay run`) ---
# Agent runs are evaluated when they end. One with no events this long is marked abandoned and
# evaluated; the sweep that checks runs every ASSAY_EVALUATE_SECONDS (0 = off).
# ASSAY_ABANDON_MINUTES=30
# ASSAY_EVALUATE_SECONDS=60
# ASSAY_SCHEDULE_MINUTES=60
# ASSAY_SCHEDULE_SOURCES=sql
# ASSAY_SCHEDULE_WINDOW_DAYS=1
